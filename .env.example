# Local development template. Copy to .env and set private values locally.
APP_ENV=development
APP_NAME=MemoryCare API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://memorycare_app:URL_ENCODED_PASSWORD@localhost:5432/memorycare
SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
STORAGE_ROOT=storage/private
MAX_UPLOAD_BYTES=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/wav,audio/ogg,audio/webm
CORS_ORIGINS=http://localhost:3000
DEMO_PASSWORD=replace-with-your-own-demo-password
